# Copy to .env and adjust.

# UID/GID your Samba share expects — find them with `ls -ln` on any file
# that already lives in the share. Wrong values are the #1 self-hosting
# complaint: files land unreadable on the NAS.
PUID=1000
PGID=1000

# Host path of the library (the NAS network mount). NFS strongly
# recommended over SMB — see README "Library mount".
LIBRARY_PATH=./library

# Public API base URL embedded in enrollment QR codes: what phones dial
# from anywhere. Port 443 implied; the app derives <host>:8443 for
# enrollment on the LAN.
PUBLIC_URL=https://nas.example.com
